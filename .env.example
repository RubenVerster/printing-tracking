# Host port the app is published on. The container always listens on 3000.
APP_PORT=3011

# Host port for Postgres, bound to 127.0.0.1 only. Purely for host-side tools;
# the app itself talks to db:5432 over the compose network.
DB_PORT=55433

# Only needed when running the app outside Docker (npm run dev). Must match
# DB_PORT above.
DATABASE_URL=postgres://xmas:xmas@localhost:55433/xmas
